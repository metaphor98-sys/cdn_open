# ===== 기본 =====
PORT=3000
# Nginx 같은 리버스 프록시 뒤에서 실행하면 1 (접속자 IP를 올바르게 읽어 요청 제한에 사용)
TRUST_PROXY=1

# ===== 신청서 메일 발송 (SMTP) =====
# 신청서를 받을 담당자 주소. 여러 명이면 쉼표로 구분
MAIL_TO=tech@skcdn.com
# 보내는 사람으로 표시될 주소 (SMTP 계정과 같은 도메인이어야 스팸 처리를 피함)
MAIL_FROM="SK CDN 신청 <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# 465 포트면 true, 587/25 포트(STARTTLS)면 false
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me
# 신청 고객(서비스 담당자 이메일)에게 확인 메일 사본을 보낼지 여부
SEND_CUSTOMER_COPY=true

# ===== 챗봇 =====
# faq : AI 없이 자주 묻는 질문으로만 답함. 외부 API 비용 0원
# llm : Anthropic API로 답함. 회사 API 키로 과금 (방문자의 Claude 계정은 쓰지 않음)
CHAT_MODE=faq
ANTHROPIC_API_KEY=
# 비용이 가장 낮은 모델 권장. 바꾸려면 Anthropic 문서의 모델 이름을 그대로 입력
ANTHROPIC_MODEL=claude-haiku-5-5
# 답변 1건의 최대 길이(토큰). 낮을수록 비용이 적음
CHAT_MAX_TOKENS=700
# 하루에 처리할 AI 질문 수 상한. 넘으면 그날은 자동으로 FAQ 답변으로 전환
CHAT_DAILY_LIMIT=500
# 접속자 1명(IP)당 10분에 보낼 수 있는 질문 수
CHAT_PER_IP_10MIN=20
